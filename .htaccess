# roofingsystems.co on Hostinger (Apache / LiteSpeed)
# Replaces what Vercel did: HTTPS + www, redirects, clean URLs, caching, 404.

Options -MultiViews -Indexes
DirectoryIndex index.html
# /blog must serve blog.html, not redirect to the blog/ folder
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. Force HTTPS and www (only on the real domain, so Hostinger's preview URL still works)
RewriteCond %{HTTP_HOST} ^(www\.)?roofingsystems\.co$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://www.roofingsystems.co%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^roofingsystems\.co$ [NC]
RewriteRule ^ https://www.roofingsystems.co%{REQUEST_URI} [R=301,L]

# 2. Old URLs
RewriteRule ^halo/?$ / [R=301,L]
RewriteRule ^privatemastermind-504306/?$ /privatemastermind [R=301,L]

# 3. One URL per page: /index.html -> /, /page.html -> /page, /page/ -> /page
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)/$ /$1 [R=301,L]

# 4. Clean URLs: /blog -> blog.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]
</IfModule>

# Social share image has no file extension
<Files "opengraph-image">
  ForceType image/png
</Files>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType text/plain .txt
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # HTML: always revalidate, so a new upload never serves stale pages
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Hashed build files never change
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Images and video
  <FilesMatch "\.(png|jpe?g|webp|gif|svg|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
